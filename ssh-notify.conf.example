# Скопировать в /etc/ssh-notify.conf и выставить права: chmod 600, владелец root.
# Этот файл содержит токен бота. В git его класть нельзя.
#
# Токен: пишем @BotFather, /newbot, получаем строку вида 123456789:AAxxxxxxxx
# Chat id: пишем своему боту любое сообщение, затем
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/getUpdates" | jq '.result[0].message.chat.id'
# Без первого сообщения от Вас бот писать Вам не сможет.

TG_TOKEN="123456789:ЗАМЕНИТЕ_НА_СВОЙ_ТОКЕН"
TG_CHAT_ID="000000000"

# Адреса, с которых уведомления не нужны. Через пробел, можно оставить пустым.
IGNORE_HOSTS=""
