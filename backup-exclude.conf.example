# Дополнительные исключения для backup.sh. Скопировать в backup-exclude.conf.
# Один шаблон в строке. Пустые строки и строки с # игнорируются.
# Действует на все сервера из servers.conf. Для одного сервера положите такой же
# файл с именем .backupignore прямо в его папку.
#
# Умолчания зашиты в сам скрипт и работают всегда: logs, crash-reports, cache,
# *.log.gz, libraries, versions, plugins/dynmap/web/tiles.
#
# Шаблоны сопоставляются с путем внутри папки сервера, поэтому
# plugins/CoreProtect/database.db  это конкретный файл,
# а просто  database.db  совпадет с любым файлом с таким именем на любой глубине.

# --- Карты и тайлы, они пересоздаются ---
# plugins/BlueMap/web/maps
# plugins/squaremap/web/tiles

# --- Тяжелые журналы, если готовы потерять историю ---
# plugins/CoreProtect/database.db

# --- Всякий мусор ---
# *.jar.bak
# *.tmp
# plugins/*/backup

# ВНИМАНИЕ. Прежде чем исключать данные игроков, подумайте дважды.
# Например, вот это выкинет дома, киты, варпы и балансы EssentialsX:
# plugins/Essentials/userdata
#
# Восстановите Вы после такого только карту, а игроки придут с пустыми руками
# и без домов. Если папка большая и с ней правда есть проблема, лучше не исключать,
# а снимать ее отдельным заданием с другим расписанием.
